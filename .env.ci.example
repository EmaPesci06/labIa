# Copiar a .env.ci.local y completar. Se usa solo para cargar los secretos de GitHub Actions:
#   gh secret set -f .env.ci.local
# Nunca subir .env.ci.local al repo.

# Supabase CLI (LAB-6): aplicar migraciones al proyecto labia-dev
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF_DEV=
SUPABASE_DB_PASSWORD_DEV=

# Sentry (LAB-7): subir source maps desde el build del CI
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
