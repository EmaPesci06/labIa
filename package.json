    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "posthog-js": "1.447.15",
    "posthog-node": "5.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.0",
