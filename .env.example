# Copiar a .env.local y completar. Nunca subir .env.local al repo.
# En Vercel se cargan las mismas variables (Preview y Development con labia-dev).

# App
# En local: http://localhost:3000. En Vercel: solo en Production (dominio propio); en Preview dejala vacía,
# porque src/lib/sitio.ts usa NEXT_PUBLIC_VERCEL_URL, que Vercel expone sola en cada despliegue.
NEXT_PUBLIC_SITE_URL=

# Supabase (LAB-6) — proyecto labia-dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: código de /admin y jobs. Nunca en el cliente (guía §7).
SUPABASE_SERVICE_ROLE_KEY=

# Emails con Resend (LAB-7 da la cuenta, la clave y el dominio; LAB-30 los usa).
# Sin RESEND_API_KEY el envío es un no-op seguro: la app funciona igual, solo no manda emails.
RESEND_API_KEY=
# Remitente con el dominio verificado en Resend, p. ej.: LabÍA <hola@tudominio.com>
# Sin dominio verificado, Resend solo deja mandar desde onboarding@resend.dev (el valor por defecto).
EMAIL_REMITENTE=
# Casilla de soporte a la que llegan las respuestas (reply_to).
EMAIL_SOPORTE=
# Clave para firmar los links de baja de los emails (`openssl rand -base64 32`). Solo servidor.
EMAILS_SECRET=
# Secreto de los crons de Vercel (/api/cron/*). Vercel lo manda solo como `Authorization: Bearer`.
CRON_SECRET=
# Clave HMAC de las claves del rate limit (`openssl rand -base64 32`). Solo servidor. Es obligatoria en
# Production y en Preview (y en cualquier `NODE_ENV=production`, p. ej. `pnpm start` local): si falta, las
# acciones con límite fallan con la página de error en vez de guardar claves sin llave. Solo `next dev` y
# vitest pueden no tenerla (usan sha256). Cargarla en Vercel (Production y Preview, valores distintos).
RATE_LIMIT_SECRET=

# Errores con Sentry (LAB-7). Si faltan, Sentry no se inicializa.
# El DSN no es secreto: NEXT_PUBLIC_SENTRY_DSN lo usa el navegador; el servidor usa SENTRY_DSN
# y, si falta, NEXT_PUBLIC_SENTRY_DSN. Basta con cargar el mismo valor en las dos.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# ORG, PROJECT y AUTH_TOKEN solo hacen falta para subir los source maps en el build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Métricas con PostHog (LAB-7). Si faltan, PostHog no se inicializa (ni en el navegador
# ni en el servidor). Es la "Project API key" (phc_…), que es pública.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com o https://eu.i.posthog.com según la región elegida
NEXT_PUBLIC_POSTHOG_HOST=

# Sesión falsa solo para desarrollo y e2e (LAB-13). Si LABIA_ROL_DEV queda vacío (lo normal), la
# app usa la sesión real de Supabase Auth (LAB-16). Con "cliente" o "profesional" simula ese usuario
# sin Supabase.
LABIA_ROL_DEV=
# Id del profesional para el link "Mi perfil" (por defecto "demo").
LABIA_ID_DEV=
# En producción las dos se ignoran; solo Playwright las habilita con LABIA_PERMITIR_ROL_DEV=1.
# No cargar ninguna de las tres en Vercel.

# Pruebas e2e del camino completo (crear cuenta, salir, ingresar) contra el Supabase de desarrollo,
# que tiene que tener la confirmación de email desactivada. Poné 1 para correrlas.
E2E_AUTH=

# LAB-35 · Poné "true" cuando un abogado haya revisado /terminos y /privacidad: se oculta el aviso
# "Versión borrador". Cualquier otro valor (o vacío) lo muestra.
NEXT_PUBLIC_LEGALES_REVISADOS=
